# Bootstrap credentials are supplied independently of database-managed secrets.
FACTORY_ORIGIN=https://factory.example.com
FACTORY_DATABASE_URL=ws://127.0.0.1:8000/rpc
FACTORY_DATABASE_NAMESPACE=factory
FACTORY_DATABASE_NAME=factory
FACTORY_DATABASE_USER=replace-with-server-only-account
FACTORY_DATABASE_PASSWORD=replace-at-deployment
FACTORY_OIDC_ISSUER=https://identity.example.com
FACTORY_OIDC_CLIENT_ID=factory
FACTORY_OIDC_CLIENT_SECRET=replace-at-deployment
FACTORY_OIDC_AUTH_METHOD=client_secret_post
# Set true only after agreeing the configured issuer's email verification contract.
FACTORY_TRUST_VERIFIED_EMAIL=false
FACTORY_ALLOW_LOOPBACK_HTTP=false
FACTORY_CREDENTIAL_MAXIMUM_DAYS=90
FACTORY_INVITATION_DAYS=7
FACTORY_INSTALLATION=replace-with-stable-installation-id
FACTORY_ROOT_KEY_VERSION=root-1
FACTORY_ROOT_KEY_FILE=/run/secrets/factory-root.key
FACTORY_RING_DIRECTORY=/var/lib/factory-key-ring
# Independently mounted operator-controlled remote filesystem, outside active volumes.
FACTORY_RING_BACKUP_DIRECTORY=/mnt/factory-recovery/key-rings
FACTORY_MAINTENANCE=false

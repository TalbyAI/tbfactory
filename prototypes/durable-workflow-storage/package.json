{
  "name": "durable-workflow-storage-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.14.1"
  },
  "scripts": {
    "check": "node check.mjs",
    "format": "npm run format:code && npm run format:markdown",
    "format:check": "npm run format:code:check && npm run format:markdown:check",
    "format:code": "biome format --write .",
    "format:code:check": "biome format .",
    "format:markdown": "markdownlint-cli2 --fix",
    "format:markdown:check": "markdownlint-cli2"
  },
  "dependencies": {
    "@mastra/core": "1.74.0",
    "@mastra/libsql": "1.25.0",
    "@surrealdb/mastra-ai": "1.0.0-beta.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "markdownlint-cli2": "0.23.3"
  }
}

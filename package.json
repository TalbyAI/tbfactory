{
  "name": "tbfactory",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "operator": "tsx scripts/operator.ts",
    "worker": "tsx scripts/worker.ts",
    "acceptance": "tsx tests/acceptance.ts",
    "acceptance:reviews": "tsx tests/review-acceptance.ts",
    "acceptance:publications": "tsx tests/publication-acceptance.ts",
    "acceptance:sharing": "tsx tests/sharing-acceptance.ts",
    "format": "npm run format:code && npm run format:markdown",
    "format:check": "npm run format:code:check && npm run format:markdown:check",
    "format:code": "biome format --write .",
    "format:code:check": "biome format .",
    "format:markdown": "markdownlint-cli2 --fix",
    "format:markdown:check": "markdownlint-cli2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.35",
    "@ai-sdk/openai": "3.0.41",
    "@mastra/core": "1.74.0",
    "@mastra/docker": "0.9.2",
    "@mastra/libsql": "1.25.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "openid-client": "6.8.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "surrealdb": "2.0.10",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "@types/oidc-provider": "9.12.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jose": "6.2.12",
    "markdownlint-cli2": "0.23.3",
    "nitro": "3.0.260903-beta",
    "oidc-provider": "9.12.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
